.venv/
venv/
env/

# Django
*.sqlite3
local_settings.py
static/
media/
*.log

# Distribution / packaging
dist/
build/
*.egg-info/

# Environment / secrets
.env
.env.*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code local state. `worktrees/` holds embedded git repos -- `git add -A` picks them
# up as gitlinks, which is how one nearly landed in a commit. `settings.local.json` is
# machine-local by convention; a shared .claude/settings.json can still be committed.
.claude/worktrees/
.claude/settings.local.json
.claude/.DS_Store

# `./mutint docs` build tree and output.
/.docs-build/
/site/
