# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo

# Managed environments — env/ holds the venv (env/main) and any future venvs/conda envs
.venv/
venv/
env/

# Django
# The local database and the sidecar files SQLite writes beside it. Naming only
# *.sqlite3 left a 320 KB *.sqlite3-journal sitting untracked in the working tree,
# one interrupted write away from being committed. mutint-core lists the same three.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
local_settings.py
static/
media/
*.log

# Distribution / packaging
dist/
build/
*.egg-info/

# Environment / secrets
.env
.env.*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code local state. `worktrees/` holds embedded git repos -- `git add -A` picks them
# up as gitlinks, which is how one nearly landed in a commit. `settings.local.json` is
# machine-local by convention; a shared .claude/settings.json can still be committed.
.claude/worktrees/
.claude/settings.local.json
.claude/.DS_Store

# `./mutint docs` build tree and output.
/.docs-build/
/site/

# The managed file store: uploaded .gd files, reference genomes, alignments and BigWigs,
# keyed by database id. Runtime data this project owns, not source. aledb has always
# ignored this; MutInt did not need to, because its store was inside its own mutint-core
# submodule until MUTINT_STORE_DIR was re-pointed at the project root.
/mutint_store/
# ...and one moved aside, which is what a migration reset asks for: primary keys restart
# at 1 while store paths are derived from them, so the old files have to leave the way.
/mutint_store.*/

# Everything a checkout would lose: the file store (data/store) and the database
# (data/db). env/ holds only what can be rebuilt.
/data/
