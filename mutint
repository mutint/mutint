#!/usr/bin/env python3
import configparser, hashlib, os, subprocess, sys

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
_VENV = os.path.join(BASE_DIR, 'env', 'main')
_VENV_READY = os.path.join(_VENV, '.installed')
# env/ is a container for managed environments: env/main is the Python venv, env/tools the
# external binaries any component asked for in its tools.txt.
_TOOLS = os.path.join(BASE_DIR, 'env', 'tools')
_TOOLS_READY = os.path.join(_TOOLS, '.installed')
# micromamba lives beside the environment it builds, never inside it: micromamba refuses to
# create into a prefix that already holds a non-conda folder, so a copy under env/tools/bin
# makes the solve abort with "Non-conda folder exists at prefix".
_MAMBA_DIR = os.path.join(BASE_DIR, 'env', 'micromamba')
# The interpreter env/main is built from. Provisioned by micromamba rather than taken from the
# host, because the host's python3 is whatever the machine happens to have -- 3.9 on macOS
# Sonoma, which no supported Django accepts any more -- and "install a newer Python first" is
# not a first step this suite asks anybody for. Everything else here already arrives this way.
#
# Bumping this rebuilds env/main, because a venv cannot be re-based on a different interpreter
# and the fingerprint below covers this spec for exactly that reason.
_PY_DIR = os.path.join(BASE_DIR, 'env', 'python')
_PY_READY = os.path.join(_PY_DIR, '.installed')
_PYTHON_SPEC = 'python=3.13.*'

_submodule_paths = []
_gitmodules = os.path.join(BASE_DIR, '.gitmodules')
if os.path.isfile(_gitmodules):
    _cfg = configparser.ConfigParser()
    _cfg.read(_gitmodules)
    for _section in _cfg.sections():
        _path = _cfg.get(_section, 'path', fallback=None)
        if _path:
            _full = os.path.join(BASE_DIR, _path)
            _submodule_paths.append(_full)
            if _full not in sys.path:
                sys.path.append(_full)

# Where the code finds the binaries at runtime. Exported here rather than derived in settings
# because settings cannot know it: an assembled project reaches get_base_settings() through
# aledb-core's config/defaults.py, which passes the *aledb-core* directory as base_dir, so
# anything derived there points inside the submodule -- the same trap templates/ and
# staticfiles/ have to work around. This script is the one place that knows the project root.
# os.execv carries the current environment, so this survives the re-exec below.
os.environ.setdefault('ALEDB_TOOLS_DIR', _TOOLS)

_MICROMAMBA_PLATFORMS = {
    ('Darwin', 'arm64'): 'osx-arm64',
    ('Darwin', 'x86_64'): 'osx-64',
    ('Linux', 'x86_64'): 'linux-64',
    ('Linux', 'aarch64'): 'linux-aarch64',
}


def _tool_specs():
    """Conda package specs from every component's tools.txt, in .gitmodules order.

    Discovered exactly the way requirements.txt already is, and for the same reason: a
    component declares what it needs beside its own code, and nothing central lists them.
    This cannot be a Django registry -- installation happens before Django exists.
    """
    specs = []
    for full in _submodule_paths + [BASE_DIR]:
        path = os.path.join(full, 'tools.txt')
        if not os.path.isfile(path):
            continue
        with open(path) as handle:
            for line in handle:
                line = line.split('#', 1)[0].strip()
                if line and line not in specs:
                    specs.append(line)
    return specs


def _micromamba():
    """Path to micromamba inside env/tools, downloading the static binary if need be.

    A single self-contained executable, so this needs no conda on the host and touches
    nothing outside env/.
    """
    import platform, tarfile, urllib.request

    exe = os.path.join(_MAMBA_DIR, 'bin', 'micromamba')
    if os.path.isfile(exe):
        return exe

    key = (platform.system(), platform.machine())
    target = _MICROMAMBA_PLATFORMS.get(key)
    if target is None:
        raise SystemExit(
            "No micromamba build known for %s/%s. Install the tools in tools.txt yourself "
            "and put them on PATH; aledb-core falls back to PATH when env/tools has no "
            "copy." % key)

    url = 'https://micro.mamba.pm/api/micromamba/%s/latest' % target
    print("Downloading micromamba for %s..." % target)
    os.makedirs(_MAMBA_DIR, exist_ok=True)
    archive = os.path.join(_MAMBA_DIR, 'micromamba.tar.bz2')
    urllib.request.urlretrieve(url, archive)
    with tarfile.open(archive, 'r:bz2') as tar:
        member = tar.getmember('bin/micromamba')
        tar.extract(member, _MAMBA_DIR)
    os.remove(archive)
    os.chmod(exe, 0o755)
    return exe


def _digest(payload):
    return hashlib.sha256(payload.encode('utf-8')).hexdigest()


def _sentinel_matches(path, payload):
    """Whether the sentinel at `path` records exactly this payload.

    A sentinel holds a fingerprint of what built the environment, not merely the fact that
    something did. Checked by existence, as these were, **adding a line to a tools.txt or a
    requirements.txt was a silent no-op for every checkout that had ever run the installer** --
    which is every checkout anybody actually works in. The failure arrives much later, as a
    missing binary or an ImportError, with nothing pointing back at the file that was edited.
    """
    try:
        with open(path) as handle:
            return handle.read().strip() == _digest(payload)
    except (IOError, OSError):
        return False


def _write_sentinel(path, payload):
    with open(path, 'w') as handle:
        handle.write(_digest(payload))


def _requirements_payload():
    """What env/main is built from: the interpreter spec, then every requirements.txt.

    Contents rather than paths, so bumping a pin re-installs. The path is included too, or two
    components swapping identical files would look like a change. The interpreter leads, so
    changing it invalidates the venv the same way a changed pin does.
    """
    parts = [_PYTHON_SPEC]
    for full in _submodule_paths + [BASE_DIR]:
        req = os.path.join(full, 'requirements.txt')
        if os.path.isfile(req):
            with open(req) as handle:
                parts.append(os.path.relpath(req, BASE_DIR) + '\n' + handle.read())
    return '\n'.join(parts)


def _install_tools():
    specs = _tool_specs()
    if not specs:
        return
    payload = '\n'.join(specs)
    if _sentinel_matches(_TOOLS_READY, payload):
        return

    print("Installing external tools (%s)..." % ', '.join(specs))
    # `install` rather than `create` once the prefix exists, so adding a spec adds a package
    # instead of failing on a directory that is already there. Note neither one *removes* a
    # spec that was deleted from a tools.txt -- `rm -rf env/tools` is how you do that.
    action = 'install' if os.path.isdir(os.path.join(_TOOLS, 'conda-meta')) else 'create'
    subprocess.check_call([_micromamba(), action, '-y', '-p', _TOOLS,
                           '-c', 'conda-forge', '-c', 'bioconda'] + specs)
    # Written last, as env/main/.installed is: a solve that dies partway must not look
    # complete on the next run.
    _write_sentinel(_TOOLS_READY, payload)


def _install_python():
    """Path to the managed interpreter, provisioning it if need be."""
    exe = os.path.join(_PY_DIR, 'bin', 'python')
    if os.path.isfile(exe) and _sentinel_matches(_PY_READY, _PYTHON_SPEC):
        return exe
    print("Installing Python (%s)..." % _PYTHON_SPEC)
    action = 'install' if os.path.isdir(os.path.join(_PY_DIR, 'conda-meta')) else 'create'
    subprocess.check_call([_micromamba(), action, '-y', '-p', _PY_DIR,
                           '-c', 'conda-forge', _PYTHON_SPEC])
    _write_sentinel(_PY_READY, _PYTHON_SPEC)
    return exe


def _python_version(python):
    """`major.minor` of an interpreter, as a string."""
    out = subprocess.check_output(
        [python, '-c', 'import sys; sys.stdout.write("%d.%d" % sys.version_info[:2])'])
    return out.decode('utf-8').strip()


def _venv_version(venv):
    """`major.minor` an existing venv was built for, from its pyvenv.cfg, or None."""
    try:
        with open(os.path.join(venv, 'pyvenv.cfg')) as handle:
            for line in handle:
                key, _, value = line.partition('=')
                if key.strip() == 'version':
                    return '.'.join(value.strip().split('.')[:2])
    except (IOError, OSError):
        pass
    return None


def _install():
    python = _install_python()
    # A venv cannot be re-based on a different interpreter, so an interpreter change means
    # building a new one. Left alone, a checkout that already has env/main would keep running
    # the old Python for ever and the upgrade would land for nobody.
    #
    # Compared by *version*, not by path, and that distinction is the whole of this check:
    # env/main/bin/python is a symlink into env/python, so upgrading that prefix in place
    # re-points the venv at the new interpreter while its packages stay in the old
    # lib/pythonX.Y. The venv then has no pip and no Django and reports the new version
    # perfectly happily. A path comparison sees nothing wrong, because nothing moved.
    if os.path.isdir(_VENV) and _venv_version(_VENV) != _python_version(python):
        print("Rebuilding the virtual environment on %s..." % _PYTHON_SPEC)
        import shutil
        shutil.rmtree(_VENV)
    if not os.path.isdir(_VENV):
        print("Creating virtual environment...")
        os.makedirs(os.path.dirname(_VENV), exist_ok=True)
        subprocess.check_call([python, '-m', 'venv', _VENV])
    pip = os.path.join(_VENV, 'bin', 'pip')
    for full in _submodule_paths:
        req = os.path.join(full, 'requirements.txt')
        if os.path.isfile(req):
            print(f"Installing {os.path.relpath(full, BASE_DIR)}/requirements.txt...")
            subprocess.check_call([pip, 'install', '-r', req])
    root_req = os.path.join(BASE_DIR, 'requirements.txt')
    if os.path.isfile(root_req):
        print("Installing requirements.txt...")
        subprocess.check_call([pip, 'install', '-r', root_req])
    _write_sentinel(_VENV_READY, _requirements_payload())
    _install_tools()
    print("\nInstallation complete.")


if len(sys.argv) > 1 and sys.argv[1] == 'install':
    _install()
else:
    # Auto-install and re-exec under venv if not already inside it.
    if os.path.normpath(sys.prefix) != os.path.normpath(_VENV):
        if not _sentinel_matches(_VENV_READY, _requirements_payload()):
            _install()
        # A checkout whose venv predates tools.txt, or whose earlier solve failed, still
        # gets one -- the venv sentinel says nothing about the tools.
        _install_tools()
        _venv_python = os.path.join(_VENV, 'bin', 'python')
        os.execv(_venv_python, [_venv_python] + sys.argv)

    from aledb_common.cli import manage
    if __name__ == '__main__':
        manage()
