#!/bin/sh
# The bundle executable, and it *is* the server rather than a launcher for one.
#
# It used to `osascript` Terminal into running the .command and then return, so the app
# exited within a second of being clicked: there was no MutInt to quit, the Dock icon was
# gone, and stopping the server meant finding the right Terminal window and pressing
# Ctrl-C. Everything below follows from exec'ing the thing instead of delegating it.
#
# Three properties this buys, each verified rather than assumed:
#
#   * **The Dock tile lasts as long as MutInt.** `exec` preserves the pid all the way down
#     -- this script, the .command, `./mutint`, and its own `os.execv` into the venv Python
#     are one process -- and a bundle whose executable is a plain shell script still
#     registers as ApplicationType=Foreground, so it gets a real tile.
#   * **A second click cannot start a second server.** LaunchServices runs one instance per
#     bundle identifier and drops the extra launch (three `open`s, one process). It sends a
#     reopen event, which a shell script has no way to answer, so a click while running does
#     nothing at all.
#   * **Being killed outright still cleans up.** launchd starts an app as its own process
#     group leader (pid == pgid), and `start.py` arms the deadman supervisor's group cleanup
#     only when it leads its group -- so under the app it is armed, and `kill -9` takes the
#     runserver child, the background worker and the PostgreSQL cluster with it.
#
# What is *not* here is a handler for the Quit event: a shell script cannot have one, so
# Dock > Quit is not answered; Force Quit is clean, per the third point above.
# docs/installing.md has the user-facing half of this.
#
# ../../.. walks MacOS -> Contents -> MutInt.app -> the project root, so the app finds the
# checkout it is sitting in, with no path baked in.
here="$(cd "$(dirname "$0")/../../.." && pwd)" || exit 1
cd "$here" || exit 1

# Under `data/`, with the database and the file store, because that is the directory an
# upgrade does not replace -- and because a log worth attaching to a bug report should not
# live somewhere `rm -rf env` reaches.
log="$here/data/server.log"
mkdir -p "$here/data" 2>/dev/null

# One rotation. The log you want is usually the run *before* the one you just started by
# clicking the icon again to see whether it failed the same way twice.
#
# Asked here as well as in the .command, which is not quite duplication: there it decides
# whether to *start*, and here it decides whether this launch is going to produce a log at
# all. Without it, clicking the icon while MutInt is already running -- which correctly does
# nothing but open a browser tab -- would still rotate, and two such clicks would push the
# last real log out of `.1` and leave two empty files.
if ! nc -z 127.0.0.1 8000 2>/dev/null; then
    [ -s "$log" ] && mv -f "$log" "$log.1" 2>/dev/null
fi

MUTINT_LOG_FILE="$log"
export MUTINT_LOG_FILE
exec "$here/Start MutInt.command" >>"$log" 2>&1
